[Desktop Entry]
Type=Application
Name=Lumen
Name[zh_CN]=鹿门
Comment=Screenshot, annotate, pin and record
Comment[zh_CN]=截图、标注、贴图与录屏
Exec=@LUMEN@ capture
Icon=io.github.lumen.Lumen
Terminal=false
Categories=Utility;Graphics;
Keywords=screenshot;snip;pin;record;截图;贴图;录屏;lumen;
StartupNotify=false
X-GNOME-UsesNotifications=true
Actions=pin;

[Desktop Action pin]
Name=Pin clipboard
Name[zh_CN]=贴图
Exec=@LUMEN@ pin
